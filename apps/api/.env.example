PORT=3000

# --- API auth ---
# Guards all /verification routes. Set a real unique secret before going
# live or accepting requests from outside this machine.
DASHBOARD_API_KEY=changeme_dev_only

# --- CALL-E (visitor verification calls) ---
# Defaults to dry_run: no real calls are placed, safe to test end-to-end.
CALLE_MODE=dry_run
CALLE_API_KEY=CALLE_API_KEY=iams_live_pGMHFmEnz5vyYyAmljr5_af9a0fdf9d1d936683000754d2ce034ad3e033b830e255d458faba1d65df208f

# Required in addition to CALLE_MODE=live before any real call is placed —
# a deliberate two-step guard against accidentally dialing real people.
CALLE_LIVE_CONFIRM=

# --- AWS Bedrock (AWS Builder mini challenge — second-opinion risk flagging) ---
AWS_REGION=us-east-1
# Claude 3 Haiku is End-of-Life on Bedrock (Sept 10, 2026). Using its
# replacement, Claude Haiku 4.5, via the cross-region inference profile ID.
# If you get a "model not found"/access error, check the Bedrock console
# under Model access and enable this model for your account first.
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
# AWS credentials picked up from your environment / AWS CLI profile —
# do not hardcode keys here.

# --- Ring (added once the Ring event mapper is wired in) ---
RING_CLIENT_ID=
RING_CLIENT_SECRET=
RING_REFRESH_TOKEN=
